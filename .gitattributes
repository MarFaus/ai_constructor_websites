* text=auto eol=lf

# Windows-скрипты должны оставаться с CRLF, иначе cmd.exe ломает синтаксис
*.bat text eol=crlf
*.cmd text eol=crlf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
